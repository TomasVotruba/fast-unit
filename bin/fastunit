#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Thin PHP shim that fetches the matching prebuilt `fastunit` Go binary from a
 * GitHub release (once, cached in the package), verifies its sha256, then execs
 * it with the forwarded arguments.
 *
 * Kept PHP 7.2-compatible on purpose: the shim is the only code that runs in the
 * consuming project, and the Go binary itself is language-version-agnostic, so
 * fast-unit can accelerate suites on legacy PHP too.
 *
 * Overrides:
 *   FASTUNIT_BINARY=/abs/path   use this binary, skip all download logic
 *   FASTUNIT_VERSION=vX.Y.Z      pin a specific release tag
 */

const REPO = 'tomasvotruba/fast-unit';
const VERSION = 'v0.1.1'; // bumped per release tag; matches the built binaries

$args = array_slice($argv, 1);

// 1. explicit override wins.
$override = getenv('FASTUNIT_BINARY');
if (is_string($override) && $override !== '') {
    exit(runBinary($override, $args));
}

// 2. resolve platform -> asset name.
$asset = assetName();

$version = getenv('FASTUNIT_VERSION');
if (! is_string($version) || $version === '') {
    $version = VERSION;
}

// 3. cache binary inside the package dir: .bin/<version>/<asset>.
$cacheDir = __DIR__ . '/../.bin/' . $version;
$binary = $cacheDir . '/' . $asset;

if (! is_file($binary)) {
    if (! is_dir($cacheDir) && ! @mkdir($cacheDir, 0755, true) && ! is_dir($cacheDir)) {
        fwrite(STDERR, "fastunit: cannot create cache dir {$cacheDir}\n");
        exit(1);
    }

    $base = 'https://github.com/' . REPO . '/releases/download/' . $version;
    download($base . '/' . $asset, $binary);
    verifyChecksum($base . '/checksums.txt', $binary, $asset);

    if (PHP_OS_FAMILY !== 'Windows') {
        @chmod($binary, 0755);
    }
}

exit(runBinary($binary, $args));

/**
 * @return string asset filename for the current OS/arch
 */
function assetName(): string
{
    switch (PHP_OS_FAMILY) {
        case 'Darwin':
            $os = 'darwin';
            break;
        case 'Windows':
            $os = 'windows';
            break;
        default:
            $os = 'linux';
    }

    $machine = strtolower(php_uname('m'));
    if (strpos($machine, 'arm64') !== false || strpos($machine, 'aarch64') !== false) {
        $arch = 'arm64';
    } else {
        $arch = 'amd64';
    }

    $suffix = $os === 'windows' ? '.exe' : '';

    return sprintf('fastunit-%s-%s%s', $os, $arch, $suffix);
}

function download(string $url, string $dest): void
{
    $data = httpGet($url);
    if ($data === null) {
        fwrite(STDERR, "fastunit: download failed: {$url}\n");
        exit(1);
    }
    file_put_contents($dest, $data);
}

function verifyChecksum(string $checksumsUrl, string $binary, string $asset): void
{
    $list = httpGet($checksumsUrl);
    if ($list === null) {
        fwrite(STDERR, "fastunit: cannot fetch checksums: {$checksumsUrl}\n");
        exit(1);
    }

    $expected = null;
    foreach (explode("\n", $list) as $line) {
        // format: "<sha256>  <asset>"
        $parts = preg_split('/\s+/', trim($line));
        if ($parts !== false && count($parts) === 2 && $parts[1] === $asset) {
            $expected = strtolower($parts[0]);
            break;
        }
    }

    if ($expected === null) {
        fwrite(STDERR, "fastunit: no checksum entry for {$asset}\n");
        exit(1);
    }

    $actual = hash_file('sha256', $binary);
    if (! hash_equals($expected, $actual)) {
        @unlink($binary);
        fwrite(STDERR, "fastunit: checksum mismatch for {$asset}\n");
        exit(1);
    }
}

/**
 * @return string|null
 */
function httpGet(string $url)
{
    $context = stream_context_create([
        'http' => ['follow_location' => 1, 'timeout' => 60],
        'ssl' => ['verify_peer' => true, 'verify_peer_name' => true],
    ]);
    $data = @file_get_contents($url, false, $context);

    return $data === false ? null : $data;
}

/**
 * @param string[] $args
 */
function runBinary(string $binary, array $args): int
{
    $cmd = escapeshellarg($binary);
    foreach ($args as $arg) {
        $cmd .= ' ' . escapeshellarg($arg);
    }

    $return = 0;
    passthru($cmd, $return);

    return $return;
}
