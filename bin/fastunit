#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Thin PHP shim that execs the matching prebuilt `fastunit` Go binary committed
 * under bin/dist/. No network download, no toolchain - the binary ships in the
 * package.
 *
 * Kept PHP 7.2-compatible on purpose: the shim is the only code that runs in the
 * consuming project, and the Go binary itself is language-version-agnostic, so
 * fast-unit can accelerate suites on legacy PHP too.
 *
 * Overrides:
 *   FASTUNIT_BINARY=/abs/path   use this binary, skip the bundled one
 */

$args = array_slice($argv, 1);

// 1. explicit override wins.
$override = getenv('FASTUNIT_BINARY');
if (is_string($override) && $override !== '') {
    exit(runBinary($override, $args));
}

// 2. resolve platform -> bundled binary under bin/dist/.
$binary = __DIR__ . '/dist/' . assetName();

if (! is_file($binary)) {
    fwrite(STDERR, "fastunit: bundled binary not found: {$binary}\nrun ./build.sh to (re)generate it\n");
    exit(1);
}

if (PHP_OS_FAMILY !== 'Windows') {
    @chmod($binary, 0755);
}

exit(runBinary($binary, $args));

/**
 * @return string asset filename for the current OS/arch
 */
function assetName(): string
{
    switch (PHP_OS_FAMILY) {
        case 'Darwin':
            $os = 'darwin';
            break;
        case 'Windows':
            $os = 'windows';
            break;
        default:
            $os = 'linux';
    }

    $machine = strtolower(php_uname('m'));
    if (strpos($machine, 'arm64') !== false || strpos($machine, 'aarch64') !== false) {
        $arch = 'arm64';
    } else {
        $arch = 'amd64';
    }

    $suffix = $os === 'windows' ? '.exe' : '';

    return sprintf('fastunit-%s-%s%s', $os, $arch, $suffix);
}

/**
 * @param string[] $args
 */
function runBinary(string $binary, array $args): int
{
    $cmd = escapeshellarg($binary);
    foreach ($args as $arg) {
        $cmd .= ' ' . escapeshellarg($arg);
    }

    $return = 0;
    passthru($cmd, $return);

    return $return;
}
